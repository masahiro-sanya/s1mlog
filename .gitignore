# dependencies
/front/node_modules
/front/.pnp
.pnp.js

# testing
/front/coverage
/front/test-results/
/front/playwright-report/

# next.js
/front/.next/
/front/out/

# production
/front/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

package-lock.json

# Claude related files
CLAUDE.md
.claude
*.claude

# Serena MCP Server
.serena/

# Playwright MCP (auto-generated console logs / page snapshots)
.playwright-mcp/

# MCP config (may reference secrets via env)
.mcp.json

# user-requested ignore
AGENTS.md

# local-only docs (blog ideas, drafts, etc.) — git管理対象外（symlink運用のため末尾スラッシュなし）
/localdocs

# article assets (thumbnail HTML/PNG generation) — local-only
.article-assets/

# next-sitemap generated files (postbuild で自動生成されるため git 管理対象外)
front/public/robots.txt
front/public/sitemap.xml
front/public/sitemap-*.xml
